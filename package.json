{
  "name": "finance",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "test": "pnpm run test:smoke && pnpm run test:month-key && pnpm run test:sql && pnpm run test:packages",
    "test:smoke": "vitest run tests/domain-external-consumer-smoke.test.ts",
    "test:packages": "pnpm -r --filter \"./packages/*\" test",
    "test:rls": "vitest run supabase/tests/rls.test.ts",
    "test:entry-rpc": "vitest run supabase/tests/entry-rpc.test.ts",
    "test:seam": "pnpm --filter web test:seam",
    "test:db": "pnpm run test:rls && pnpm run test:entry-rpc",
    "test:month-key": "vitest run supabase/tests/month-key.test.ts",
    "test:sql": "vitest run supabase/tests/migration-invariants.test.ts",
    "typecheck": "pnpm run typecheck:root && pnpm run typecheck:packages",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck:packages": "pnpm -r --filter \"./packages/*\" typecheck"
  },
  "dependencies": {
    "@finance/domain": "workspace:*"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
